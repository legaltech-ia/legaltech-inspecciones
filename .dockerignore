# Lo que no debe entrar al contexto de build.

# Se reinstalan/reconstruyen dentro de la imagen; copiarlos la ensucia y rompe
# node_modules si el host no es linux.
node_modules
dist
.git

# Secretos: no tienen por que viajar al contexto de build. (El ENV del
# Dockerfile gana de todos modos: Vite aplica process.env despues de los
# archivos .env; no es este archivo lo que protege VITE_API_BASE_URL.)
.env
.env.local
.env.*.local

# Datos reales del despacho (nombres, cedulas, direcciones). Estan en
# .gitignore, no viajan al host, y tampoco deben acabar en una imagen.
public/Plantillas
local-data

# Ruido local: logs, notas y salidas de herramientas.
*.log
.claude
.superpowers
.omo
graphify-out
docs
e2e
